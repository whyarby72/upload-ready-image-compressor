<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/dialog_surface" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Custom upload limit" android:textColor="@color/ur_text" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Set the maximum file size for this photo." style="@style/Text_Support" />
    <EditText android:id="@+id/customLimitInput" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:hint="e.g. 10.5" android:inputType="numberDecimal" android:singleLine="true" android:textColor="@color/ur_text" android:textColorHint="@color/ur_muted" android:background="@drawable/dialog_input" android:paddingLeft="14dp" android:paddingRight="14dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="UNIT" style="@style/Text_Label" />
    <LinearLayout android:id="@+id/unitGroup" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/segment_group" android:padding="3dp" android:orientation="horizontal">
        <TextView android:id="@+id/unitKb" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="KB" android:textColor="@color/ur_text" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/segment_selected" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/unitMb" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="MB" android:textColor="@color/ur_muted" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/segment_unselected" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <TextView android:id="@+id/customLimitHelper" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="1 KB–50 MB · use a dot or comma · up to 3 decimal places" style="@style/Text_Support" />
    <TextView android:id="@+id/customLimitValidation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/ur_error" android:textSize="13sp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="right" android:orientation="horizontal">
        <TextView android:id="@+id/customLimitCancel" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:minWidth="88dp" android:text="Cancel" android:textColor="@color/ur_muted" android:textSize="15sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/customLimitUse" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginLeft="6dp" android:gravity="center" android:minWidth="112dp" android:paddingLeft="14dp" android:paddingRight="14dp" android:text="Use limit" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:background="@drawable/button_primary" android:clickable="true" android:focusable="true" />
    </LinearLayout>
</LinearLayout>
