<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Reduce Photo Size"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.UploadReady">

        <!-- Google sample AdMob App ID. TEST integration only; replace only under a later
             production-provider authorization. UMP requires the App ID in the manifest. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".ResultContentProvider"
            android:authorities="com.afradadmedia.reducephotosize.result"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
